{
	"name": "figma-vide-compiler-preview",
	"emitLegacyScripts": false,
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"FigmaVidePreview": {
				"$path": "dist-roblox"
			},
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
